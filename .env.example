# Projeto Supabase "Premium Imoveis" (região sa-east-1).
# Ambas as chaves são públicas por natureza — quem protege os dados é a RLS,
# não o segredo da chave. Nunca colocar aqui a service_role key.
NEXT_PUBLIC_SUPABASE_URL=https://seu-projeto.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=sb_publishable_xxx

# Opcional: domínio final do site, usado em Open Graph e sitemap.
# Sem ela, a URL da Vercel é usada automaticamente.
# NEXT_PUBLIC_SITE_URL=https://premiumimoveis.com.br
